{
  "name": "timer",
  "homepage": "https://Showichiro.github.io/timer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm type-check && vite build",
    "preview": "vite preview",
    "check": "biome check --write src/ .storybook",
    "check:ci": "biome check src/ .storybook",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "i18next": "26.4.2",
    "jotai": "3.0.1",
    "jotai-optics": "0.4.0",
    "optics-ts": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.15",
    "react-joyride": "3.2.0",
    "react-timer-hook": "4.0.6",
    "theme-change": "3.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@chromatic-com/storybook": "5.4.0",
    "@storybook/addon-links": "10.6.1",
    "@storybook/addon-onboarding": "10.6.1",
    "@storybook/react": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "chromatic": "18.10.1",
    "daisyui": "5.7.47",
    "jsdom": "30.1.1",
    "rollup-plugin-visualizer": "7.1.1",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "@tailwindcss/vite": "4.3.3",
    "@storybook/addon-docs": "10.6.1",
    "@vitest/coverage-v8": "5.0.3",
    "@types/node": "26.6.3"
  },
  "engines": {
    "pnpm": "12.8.1",
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.8.1"
}
